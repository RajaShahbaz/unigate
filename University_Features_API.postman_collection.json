  "item": [
    {
      "name": "Gallery Management",
      "item": [
        {
          "name": "Public - Get University Gallery",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/universities/:universityId/gallery?category=campus&featured=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["api", "universities", ":universityId", "gallery"],
              "query": [
                {
                  "key": "category",
                  "value": "campus",
                  "description": "Filter by category"
                },
                {
                  "key": "featured",
                  "value": "1",
                  "description": "Get only featured items"
                },
                {
                  "key": "per_page",
                  "value": "10",
                  "description": "Items per page"
                }
              ],
              "variable": [
                {
                  "key": "universityId",
                  "value": "1"
                }
              ]
            }
          }

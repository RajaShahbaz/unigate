  "notes": [
    "All endpoints require authentication via Sanctum token",
    "File uploads must use multipart/form-data content type",
    "Application number is auto-generated (APP{YEAR}{NUMBER})",
    "Draft applications can be edited and deleted",
    "Submitted applications cannot be edited by students",
    "Only specific statuses can be withdrawn",
    "Custom fields are university-specific",
    "Field types determine validation rules",
    "Files are stored in public storage disk",
    "Use soft deletes for data retention"
  ]
}


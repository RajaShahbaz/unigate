  "admin_workflows": [
    {
      "name": "Setup Custom Application Fields",
      "steps": [
        {
          "step": 1,
          "description": "Create Essay Field",
          "method": "POST",
          "endpoint": "/admin/universities/1/fields",
          "headers": {
            "Authorization": "Bearer {admin_token}",
            "Content-Type": "application/json"
          },
          "body": {
            "field_name": "motivation_essay",
            "field_label": "Why This University?",
            "field_description": "Please write a 500-word essay explaining your motivation for choosing our university and this specific program.",
            "field_type": "textarea",
            "is_required": true,
            "sort_order": 0
          }
        },
        {
          "step": 2,
          "description": "Create Portfolio Upload Field",
          "method": "POST",
          "endpoint": "/admin/universities/1/fields",
          "headers": {
            "Authorization": "Bearer {admin_token}",
            "Content-Type": "application/json"
          },
          "body": {
            "field_name": "portfolio",
            "field_label": "Design Portfolio",
            "field_description": "Upload your design portfolio (PDF format only)",
            "field_type": "file",
            "file_types": "pdf",
            "max_file_size": 10240,
            "is_required": true,
            "sort_order": 1
          }
        },
        {
          "step": 3,
          "description": "Create Scholarship Interest Field",
          "method": "POST",
          "endpoint": "/admin/universities/1/fields",
          "headers": {
            "Authorization": "Bearer {admin_token}",
            "Content-Type": "application/json"
          },
          "body": {
            "field_name": "scholarship_type",
            "field_label": "Scholarship Interest",
            "field_description": "Select the type of scholarship you're interested in",
            "field_type": "select",
            "field_options": ["Merit-based", "Need-based", "Athletic", "Arts", "Not interested"],
            "is_required": false,
            "sort_order": 2
          }
        }
      ]
    },
    {
      "name": "Review Applications Workflow",
      "steps": [
        {
          "step": 1,
          "description": "Get all submitted applications",
          "method": "GET",
          "endpoint": "/admin/applications?university_id=1&status=submitted&per_page=50",
          "headers": {
            "Authorization": "Bearer {admin_token}",
            "Accept": "application/json"
          }
        },
        {
          "step": 2,
          "description": "View detailed application",
          "method": "GET",
          "endpoint": "/admin/applications/25",
          "headers": {
            "Authorization": "Bearer {admin_token}",
            "Accept": "application/json"
          }
        },
        {
          "step": 3,
          "description": "Add review notes",
          "method": "POST",
          "endpoint": "/admin/applications/25/notes",
          "headers": {
            "Authorization": "Bearer {admin_token}",
            "Content-Type": "application/json"
          },
          "body": {
            "admin_notes": "Strong academic background. GPA 3.9. Excellent recommendation letters. Portfolio shows creativity and technical skills. Recommend for shortlist."
          }
        },
        {
          "step": 4,
          "description": "Update application status to shortlisted",
          "method": "POST",
          "endpoint": "/admin/applications/25/status",
          "headers": {
            "Authorization": "Bearer {admin_token}",
            "Content-Type": "application/json"
          },
          "body": {
            "status": "shortlisted",
            "admin_notes": "Candidate meets all requirements. Schedule for interview."
          }
        },
        {
          "step": 5,
          "description": "Bulk update multiple applications",
          "method": "POST",
          "endpoint": "/admin/applications/bulk-update-status",
          "headers": {
            "Authorization": "Bearer {admin_token}",
            "Content-Type": "application/json"
          },
          "body": {
            "application_ids": [25, 26, 27, 28, 29],
            "status": "interview_scheduled",
            "admin_notes": "Batch 1 - Interviews scheduled for next week"
          }
        }
      ]
    }
  ],

  "admin_api_examples": [
    {
      "name": "Get All Applications with Filters",
      "method": "GET",
      "endpoint": "/admin/applications?university_id=1&status=under_review&interest_id=3&date_from=2025-01-01&search=john",
      "headers": {
        "Authorization": "Bearer {admin_token}",
        "Accept": "application/json"
      }
    },
    {
      "name": "Get Application Statistics",
      "method": "GET",
      "endpoint": "/admin/applications/statistics?university_id=1",
      "headers": {
        "Authorization": "Bearer {admin_token}",
        "Accept": "application/json"
      }
    },
    {
      "name": "Accept Application",
      "method": "POST",
      "endpoint": "/admin/applications/30/status",
      "headers": {
        "Authorization": "Bearer {admin_token}",
        "Content-Type": "application/json"
      },
      "body": {
        "status": "accepted",
        "admin_notes": "Congratulations! Application approved. Welcome email sent."
      }
    },
    {
      "name": "Reject Application",
      "method": "POST",
      "endpoint": "/admin/applications/31/status",
      "headers": {
        "Authorization": "Bearer {admin_token}",
        "Content-Type": "application/json"
      },
      "body": {
        "status": "rejected",
        "rejection_reason": "GPA below minimum requirement of 3.0",
        "admin_notes": "Does not meet academic standards"
      }
    },
    {
      "name": "Get Custom Fields for University",
      "method": "GET",
      "endpoint": "/admin/universities/1/fields",
      "headers": {
        "Authorization": "Bearer {admin_token}",
        "Accept": "application/json"
      }
    },
    {
      "name": "Update Custom Field",
      "method": "PUT",
      "endpoint": "/admin/universities/1/fields/5",
      "headers": {
        "Authorization": "Bearer {admin_token}",
        "Content-Type": "application/json"
      },
      "body": {
        "field_label": "Updated Label",
        "field_description": "Updated description with more details",
        "is_required": false
      }
    },
    {
      "name": "Reorder Custom Fields",
      "method": "POST",
      "endpoint": "/admin/universities/1/fields/reorder",
      "headers": {
        "Authorization": "Bearer {admin_token}",
        "Content-Type": "application/json"
      },
      "body": {
        "field_orders": [
          {"id": 3, "sort_order": 0},
          {"id": 1, "sort_order": 1},
          {"id": 2, "sort_order": 2}
        ]
      }
    },
    {
      "name": "Toggle Field Status",
      "method": "POST",
      "endpoint": "/admin/universities/1/fields/5/toggle-status",
      "headers": {
        "Authorization": "Bearer {admin_token}",
        "Accept": "application/json"
      }
    },
    {
      "name": "Delete Custom Field",
      "method": "DELETE",
      "endpoint": "/admin/universities/1/fields/5",
      "headers": {
        "Authorization": "Bearer {admin_token}",
        "Accept": "application/json"
      }
    }
  ],


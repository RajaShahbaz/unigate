{
  "name": "University Application System API Examples",
  "description": "Complete API request examples for the university application system",
  "base_url": "http://your-domain.com/api",
  "authentication": "Bearer Token (Sanctum)",
  
  "student_workflows": [
    {
      "name": "Complete Application Workflow",
      "steps": [
        {
          "step": 1,
          "description": "Get application form for Stanford University",
          "method": "GET",
          "endpoint": "/applications/universities/1/form",
          "headers": {
            "Authorization": "Bearer {student_token}",
            "Accept": "application/json"
          }
        },
        {
          "step": 2,
          "description": "Create draft application with basic info",
          "method": "POST",
          "endpoint": "/applications",
          "headers": {
            "Authorization": "Bearer {student_token}",
            "Content-Type": "application/json"
          },
          "body": {
            "university_id": 1,
            "interest_id": 3,
            "first_name": "John",
            "last_name": "Doe",
            "email": "john.doe@email.com",
            "phone": "+1234567890",
            "date_of_birth": "2000-05-15",
            "gender": "male",
            "current_address": "123 Main Street, Apt 4B, New York, NY 10001",
            "permanent_address": "456 Oak Avenue, Brooklyn, NY 11201",
            "nationality": "American",
            "previous_school": "New York High School",
            "previous_degree": "High School Diploma",
            "previous_gpa": 3.85,
            "graduation_year": 2018,
            "application_message": "I am passionate about computer science and artificial intelligence. Throughout my academic career, I have consistently demonstrated..."
          }
        },
        {
          "step": 3,
          "description": "Upload documents (use multipart/form-data)",
          "method": "PUT",
          "endpoint": "/applications/1",
          "headers": {
            "Authorization": "Bearer {student_token}",
            "Content-Type": "multipart/form-data"
          },
          "body_note": "Use form-data with files",
          "form_data": {
            "transcript_file": "[FILE]",
            "id_document_file": "[FILE]",
            "photo_file": "[FILE]",
            "recommendation_letter_file": "[FILE]"
          }
        },
        {
          "step": 4,
          "description": "Add custom field responses",
          "method": "PUT",
          "endpoint": "/applications/1",
          "headers": {
            "Authorization": "Bearer {student_token}",
            "Content-Type": "application/json"
          },
          "body": {
            "custom_fields": {
              "1": "https://myportfolio.johndoe.com",
              "2": "I chose Computer Science because of my passion for problem-solving and innovation...",
              "3": "Merit-based"
            }
          }
        },
        {
          "step": 5,
          "description": "Submit application",
          "method": "POST",
          "endpoint": "/applications/1/submit",
          "headers": {
            "Authorization": "Bearer {student_token}",
            "Accept": "application/json"
          }
        },
        {
          "step": 6,
          "description": "View application status",
          "method": "GET",
          "endpoint": "/applications/1",
          "headers": {
            "Authorization": "Bearer {student_token}",
            "Accept": "application/json"
          }
        }
      ]
    }
  ],

  "student_api_examples": [

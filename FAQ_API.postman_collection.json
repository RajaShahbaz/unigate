            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What are the admission deadlines?\",\n  \"answer\": \"Admission deadlines vary by university and program. Typically, applications open in September and close in March for the following academic year. Check each university's specific deadlines on their profile page.\",\n  \"order\": 11,\n  \"status\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/admin/faqs",
              "host": ["{{base_url}}"],
              "path": ["admin", "faqs"]
            },
            "description": "Create a new FAQ entry. Admin authentication required."
          },
          "response": []
        },
        {

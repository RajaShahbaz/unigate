            ],
            "url": {
              "raw": "{{base_url}}/admin/faqs/1/toggle-status",
              "host": ["{{base_url}}"],
              "path": ["admin", "faqs", "1", "toggle-status"]
            },
            "description": "Toggle the status of an FAQ between active and inactive. Admin authentication required."
          },
          "response": []
        },
        {
          "name": "Reorder FAQs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"faqs\": [\n    {\n      \"id\": 1,\n      \"order\": 5\n    },\n    {\n      \"id\": 2,\n      \"order\": 1\n    },\n    {\n      \"id\": 3,\n      \"order\": 2\n    },\n    {\n      \"id\": 4,\n      \"order\": 3\n    },\n    {\n      \"id\": 5,\n      \"order\": 4\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/admin/faqs/reorder",
              "host": ["{{base_url}}"],
              "path": ["admin", "faqs", "reorder"]
            },
            "description": "Update the display order of multiple FAQs at once. Useful for drag-and-drop implementations. Admin authentication required."
          },
          "response": []
        },
        {
          "name": "Delete FAQ",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/faqs/11",
              "host": ["{{base_url}}"],
              "path": ["admin", "faqs", "11"]
            },
            "description": "Delete a FAQ permanently. Admin authentication required."
          },
          "response": []
        }
      ],
      "description": "Admin APIs for complete FAQ management (CRUD operations)",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{admin_token}}",
            "type": "string"
          }
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ]
}




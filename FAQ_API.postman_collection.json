            ],
            "url": {
              "raw": "{{base_url}}/admin/faqs/statistics",
              "host": ["{{base_url}}"],
              "path": ["admin", "faqs", "statistics"]
            },
            "description": "Get statistics about FAQs (total, active, inactive counts)."
          },
          "response": []
        },
        {
          "name": "Get Single FAQ (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/faqs/1",
              "host": ["{{base_url}}"],
              "path": ["admin", "faqs", "1"]
            },
            "description": "Get a single FAQ by ID. Admin authentication required."
          },
          "response": []
        },
        {

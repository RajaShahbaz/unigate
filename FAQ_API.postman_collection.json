              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How do I apply for university admission? (Updated)\",\n  \"answer\": \"To apply for university admission, first register an account on our platform. Once registered, browse through the list of universities, select your preferred institution, and fill out the detailed application form. You can save your progress at any time and submit when all required fields are completed.\",\n  \"order\": 1,\n  \"status\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/admin/faqs/1",
              "host": ["{{base_url}}"],
              "path": ["admin", "faqs", "1"]
            },
            "description": "Update an existing FAQ. Admin authentication required."
          },
          "response": []
        },
        {
          "name": "Toggle FAQ Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"

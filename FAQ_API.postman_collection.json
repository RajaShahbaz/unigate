{
  "info": {
    "name": "FAQ Management API",
    "description": "Complete FAQ management system for university admission app. Includes public APIs for users and admin APIs for FAQ management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345"
  },
  "item": [
    {
      "name": "Public APIs",
      "item": [
        {
          "name": "Get All Active FAQs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/faqs",
              "host": ["{{base_url}}"],
              "path": ["faqs"]
            },
            "description": "Retrieve all active FAQs for display in the mobile app. No authentication required."
          },
          "response": []
        },
        {
          "name": "Get Single FAQ",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/faqs/1",
              "host": ["{{base_url}}"],
              "path": ["faqs", "1"]
            },
            "description": "Retrieve details of a specific FAQ by ID. No authentication required."
          },
          "response": []
        }
      ],
      "description": "Public APIs for app users to view FAQs"
    },
    {
      "name": "Admin APIs",
      "item": [
        {
          "name": "Get All FAQs (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/faqs?per_page=15&search=&status=",
              "host": ["{{base_url}}"],
              "path": ["admin", "faqs"],
              "query": [
                {
                  "key": "per_page",
                  "value": "15",
                  "description": "Number of items per page"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search in question and answer"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Filter by status (1=Active, 0=Inactive)"
                }
              ]
            },
            "description": "Get all FAQs with pagination, search, and filtering. Admin authentication required."
          },
          "response": []
        },
        {
          "name": "Get FAQ Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
